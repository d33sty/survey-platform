# Компоненты БД — используются в docker-compose для сервиса db и сборки DATABASE_URL
POSTGRES_USER=poll_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=poll_db

# Для локального запуска без Docker
DATABASE_URL=postgresql+asyncpg://poll_user:change-me@localhost:5432/poll_db

SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_SECRET_KEY=change-me-admin-key
